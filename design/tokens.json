{
  "$schema": "https://design-tokens.org/schemas/draft/2023-06/schema.json",
  "meta": {
    "name": "immersive-3d-blog",
    "version": "2.0.0-design-v2",
    "figma": "https://www.figma.com/design/cvPXjZWxk5bQZRA4yS4aDh",
    "themes": ["dark", "light"],
    "defaultTheme": "dark",
    "adminDefaultTheme": "light"
  },
  "color": {
    "bg": { "stage": "#03040A", "elevated": "#0F1117" },
    "text": { "primary": "#EEF2FF", "muted": "#8B9BB8" },
    "accent": {
      "cyan": "#5CE1E6",
      "cyanGlow": "#5CE1E6",
      "violet": "#8B5CFF",
      "peach": "#FFB89E",
      "lilac": "#C7ADFF"
    },
    "glass": {
      "fill": "rgba(255,255,255,0.06)",
      "border": "rgba(255,255,255,0.18)",
      "highlight": "rgba(255,255,255,0.28)"
    }
  },
  "themes": {
    "dark": {
      "color": {
        "bg": { "stage": "#03040A", "elevated": "#0F1117" },
        "text": { "primary": "#EEF2FF", "muted": "#8B9BB8" },
        "accent": {
          "cyan": "#5CE1E6",
          "cyanGlow": "#5CE1E6",
          "violet": "#8B5CFF",
          "peach": "#FFB89E",
          "lilac": "#C7ADFF"
        },
        "glass": {
          "fill": "rgba(255,255,255,0.06)",
          "border": "rgba(255,255,255,0.18)",
          "highlight": "rgba(255,255,255,0.28)"
        },
        "backdropType": "#EEF2FF"
      },
      "gradient": {
        "heroGlow": "linear-gradient(90deg, #FFB89E 0%, #E6C0F2 50%, #C7ADFF 100%)"
      },
      "orb": {
        "cyan": "rgba(92,225,230,0.22)",
        "violet": "rgba(139,92,255,0.2)",
        "peach": "rgba(255,184,158,0.14)"
      }
    },
    "light": {
      "selector": "[data-theme=light]",
      "color": {
        "bg": { "stage": "#FAFAFB", "elevated": "#FFFFFF" },
        "text": { "primary": "#17171C", "muted": "#5C6578" },
        "accent": {
          "cyan": "#0A8A90",
          "cyanGlow": "#5CE1E6",
          "violet": "#6B3FE0",
          "peach": "#D97757",
          "lilac": "#7C5CCF"
        },
        "glass": {
          "fill": "rgba(255,255,255,0.55)",
          "border": "rgba(0,0,0,0.08)",
          "highlight": "rgba(255,255,255,0.85)"
        },
        "backdropType": "#17171C"
      },
      "gradient": {
        "heroGlow": "linear-gradient(90deg, #D97757 0%, #B08AC8 50%, #7C5CCF 100%)"
      },
      "orb": {
        "cyan": "rgba(10,138,144,0.14)",
        "violet": "rgba(107,63,224,0.12)",
        "peach": "rgba(217,119,87,0.1)"
      },
      "aaNotes": {
        "primaryText": "#17171C on #FAFAFB passes AA",
        "interactiveCyan": "Use adjusted #0A8A90 for text/UI; #5CE1E6 decorative glow only",
        "glass": "white@0.55 fill + black@0.08 border; elevate to solid if text contrast fails"
      }
    }
  },
  "gradient": {
    "heroGlow": "linear-gradient(90deg, #FFB89E 0%, #E6C0F2 50%, #C7ADFF 100%)"
  },
  "font": {
    "family": {
      "display": "Syne",
      "sans": "Inter",
      "mono": "JetBrains Mono"
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "pill": 999, "scene": 24, "pane": 20 },
  "blur": { "glass": 20 },
  "motion": {
    "fast": "150ms",
    "base": "280ms",
    "slow": "700ms",
    "orb": "24s",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1440
  },
  "glassWhitelist": [
    "AppNav",
    "SearchHud",
    "ReadingProgressHud",
    "AuthorIsland",
    "AuthorFilmStrip",
    "GlassPane",
    "AboutSlab"
  ],
  "components": [
    "AtmosphereStage",
    "GiantBackdropWord",
    "AppNav",
    "SearchHud",
    "ReadingProgressHud",
    "HeroSpatial",
    "LiquidSignature",
    "AboutSlab",
    "CinematicBand",
    "PostTypographicRow",
    "SceneRow",
    "ArticleColumn",
    "SpatialPrevNext",
    "AuthorIsland",
    "AuthorFilmStrip",
    "AuthorAvatar",
    "AuthorByline",
    "ProjectReel",
    "ProjectReelBand",
    "GlassPane",
    "ReelDots",
    "Spinner",
    "EmptyState",
    "AdminSidebar",
    "AdminTopbar",
    "AdminDataTable"
  ]
}
